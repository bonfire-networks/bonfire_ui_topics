<Bonfire.UI.Common.OpenModalLive
  id={@id}
  title_text={title(l("Create a new topic"), e(@parent, :profile, :name, nil))}
  no_actions
  open_btn_aria_label={@label}
  open_modal_wrapper_class={@open_modal_wrapper_class}
  open_btn_wrapper_class={@open_btn_wrapper_class}
>
  <div x-data="{ name: '' }" class="">
    <Form
      id="new_topic_form"
      class="flex flex-col w-full gap-3"
      for={%{}}
      as={:category}
      submit="Bonfire.UI.Topics:new"
      action="Bonfire.UI.Topics:new"
      change="Bonfire.Classify:validate"
      opts={
        autocomplete: "off",
        "phx-target": "#modal"
      }
    >
      <div class="w-full form-control">
        <label for="name" class="sr-only">{l("Topic name")}</label>
        <input
          x-model="name"
          id="name"
          name="name"
          type="text"
          placeholder={l("Type the topic name")}
          class="w-full text-sm input input-bordered"
        />
      </div>

      <div class="w-full form-control">
        <textarea
          name="summary"
          class="w-full textarea textarea-bordered"
          placeholder={l("Write a short description")}
        />
      </div>

      <div class="w-full form-control">
        <select name="to_boundaries" class="w-full select select-bordered">
          <option value="" selected>Standard: inherits the boundaries of the group</option>
          <option value="annoucement" disabled>Announcements: Only group caretakers can post</option>
          {!-- <option>Public: Anyone can post</option> --}
        </select>
      </div>

      {!-- <div class="w-full rounded form-control bg-fill">
      <div class="p-4">
        <div class="flex items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <div class="text-sm font-bold">{l("Discoverable")}</div>
            <div class="text-sm font-normal text-muted">{l("Make it publicly discoverable")}</div>
          </div>
          <input
            value="false"
            type="checkbox"
            class="toggle"
          />
        </div>
      </div>
    </div> --}

      {!-- ticked in a group marked sensitive, so its topics start marked too; each topic then keeps its own mark. An unticked box sends nothing, so the hidden `false` says so --}
      <div class="w-full form-control">
        {!-- `category[…]`, which `Bonfire.Classify.LiveHandler.new/3` merges in, rather than a bare `sensitive`, which the composer's own field is named --}
        <input type="hidden" name="category[sensitive]" value="false">
        {!-- `phx-update="ignore"`: the form's `change` (`Bonfire.Classify:validate`) re-renders it, which set `checked` back to the parent group's mark on every click, so the box couldn't be toggled; the server value is only the starting state --}
        <label
          id="new_topic_sensitive_label"
          phx-update="ignore"
          for="new_topic_sensitive"
          class="flex items-center gap-3 cursor-pointer"
        >
          <input
            id="new_topic_sensitive"
            type="checkbox"
            name="category[sensitive]"
            value="true"
            checked={Bonfire.Classify.Categories.sensitive?(@parent)}
            class="checkbox checkbox-sm"
          />
          <span class="text-sm">{l("Mark as sensitive")}</span>
        </label>
      </div>

      <input type="hidden" name="context_id" value={id(@parent)}>

      <button
        x-bind:disabled="name.length == 0"
        type="submit"
        data-role="new_topic_submit"
        class="w-full mt-3 normal-case btn btn-primary"
      >
        {l("Create")}
      </button>
    </Form>
  </div>
  <:open_btn>
    <#slot {@open_btn}>
      <span class="flex items-center gap-3 w-full text-sm text-base-content">
        <#Icon iconify="ph:chats-circle-duotone" class="size-4 shrink-0 text-muted" />
        <span class="flex-1 truncate text-left">{@label || l("New topic")}</span>
      </span>
    </#slot>
  </:open_btn>
</Bonfire.UI.Common.OpenModalLive>