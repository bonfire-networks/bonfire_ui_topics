<section
  data-id="topic_subheader"
  data-variant={if @compact, do: "compact", else: "full"}
  aria-label={l("Topic")}
  class={"border-b-hair border-divider", if(@compact, do: "bg-base-100", else: "bg-base-200")}
>
  <div
    :if={not @compact}
    id="topic-parent-banner"
    class="h-24 overflow-hidden bg-primary sm:h-28"
    aria-hidden="true"
  >
    {#case Media.banner_url(@user, fallback: false)}
      {#match nil}
      {#match banner}
        <img src={banner} alt="" class="h-full w-full object-cover">
    {/case}
  </div>
  {!-- one wrapping row, so the actions are written once: full puts the icon and actions on top and the text below; compact puts the text first, actions beside it --}
  <div class={
    "flex flex-wrap items-start gap-x-3 px-4 sm:px-6",
    if(@compact, do: "gap-y-3 py-3", else: "gap-y-4 pb-6")
  }>
      <div
        :if={not @compact}
        id="topic-icon"
        class="relative -mt-5 grid size-14 shrink-0 place-items-center overflow-hidden rounded-box border-4 border-base-200 bg-primary text-primary-content"
        aria-hidden="true"
      >
        {#case Media.avatar_url(@category)}
          {#match "/images/avatar.png"}
            <#Icon iconify="ph:hash" class="size-7" />
          {#match url}
            <img src={url} alt="" width="48" height="48" class="h-full w-full object-cover">
        {/case}
      </div>
      <div class={"ml-auto flex shrink-0 items-center gap-3 order-1", if(not @compact, do: "pt-3")}>
        <StatefulComponent
          module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
          :if={not is_nil(e(@category, :character, nil)) and current_user_id(@__context__)}
          id={ComponentID.new(Bonfire.UI.Social.Graph.FollowButtonLive, id(@category), __MODULE__)}
          object_id={uid(@category)}
          object={@category}
          path={@permalink}
          title={l("Follow topic")}
          title_already={l("Unfollow topic")}
          container_class="inline-flex items-center gap-3"
          class="btn btn-sm btn-circle border-0 bg-surface text-muted shadow-none hover:bg-fill-strong"
          class_already="btn btn-sm btn-circle border-0 bg-surface text-primary shadow-none hover:bg-fill-strong"
          bell_class="btn btn-sm btn-circle border-0 bg-surface text-muted shadow-none hover:bg-fill-strong touch-target-expanded"
          bell_class_enabled="btn btn-sm btn-circle border-0 bg-surface text-primary shadow-none hover:bg-fill-strong touch-target-expanded"
          icon="ph:rss"
          icon_already="ph:rss"
          icon_class="size-4"
          hide_text
          verb={l("Follow topic")}
          verb_undo={l("Unfollow topic")}
          verb_already={l("Following")}
        />
        <span :if={current_user_id(@__context__) &&
          Bonfire.Classify.ensure_update_allowed(current_user(@__context__), @category)}>
          <Bonfire.UI.Common.OpenModalLive
            id={"edit_topic_modal_#{uid(@category)}"}
            title_text={l("Edit topic")}
            no_actions
            open_btn_aria_label={l("Edit topic")}
          >
            <Bonfire.UI.Topics.Settings.GeneralLive category={@category} />
            <:open_btn>
              <div class="btn btn-sm btn-circle border-0 bg-surface text-muted shadow-none hover:bg-fill-strong">
                <#Icon iconify="ph:gear-six-duotone" class="size-4" />
              </div>
            </:open_btn>
          </Bonfire.UI.Common.OpenModalLive>
        </span>
      </div>
    <div class={"min-w-0", if(@compact, do: "flex-1 order-0", else: "basis-full order-2")}>
      {#if @compact}
        {!-- the page's h1 is the group's name, in the header above --}
        <h2 id="topic-title" class="flex items-center gap-1 font-semibold leading-snug text-base-content break-words">
          <#Icon iconify="ph:hash" class="size-4 shrink-0 text-muted" />
          {e(@category, :profile, :name, nil) || e(@category, :name, l("Untitled topic"))}
        </h2>
      {#else}
        <p class="mb-1 text-xs text-muted">{l("Topic")}</p>
        <h1 id="topic-title" class="type-title leading-tight text-base-content break-words">
          {e(@category, :profile, :name, nil) || e(@category, :name, l("Untitled topic"))}
        </h1>
      {/if}
      <div
        :if={e(@category, :profile, :summary, nil)}
        id="topic-description"
        class={
          "max-w-prose text-sm leading-relaxed text-muted break-words",
          if(@compact, do: "mt-0.5 line-clamp-2", else: "mt-3")
        }
      >
        {rich(e(@category, :profile, :summary, nil))}
      </div>
    </div>
  </div>
</section>
